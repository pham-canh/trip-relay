{
  "brand": "Riverside Clinic Assistant",
  "networks": [
    {
      "name": "riverside_clinic",
      "front_man": "riverside_clinic_assistant",
      "hocon": "./riverside_clinic.network.json",
      "description": "Book a clinic visit in your browser, then ask Linden Pharmacy what it offers — with a consent card before the second site is contacted.",
      "tags": [
        "agentified-website",
        "open-agentic-web",
        "health"
      ],
      "sample_queries": [
        "Which cardiology slots are open this week?",
        "Book the 10:30 slot for Alex Nguyen.",
        "Can you ask Linden Pharmacy whether they deliver?",
        "Do you handle insurance billing?"
      ]
    }
  ],
  "llm_router": {
    "base_url": "https://api.otari.ai/api/v1",
    "mock": false,
    "byok_router": "https://api.otari.ai/api/v1"
  },
  "allowed_peers": [
    "http://localhost:8081"
  ],
  "peer_policy": {
    "mode": "closed",
    "deny_origins": [],
    "note": "Calls only the Linden Pharmacy network after the visitor agrees on the consent card, plus page-local actions."
  },
  "agent_mcp": {
    "protocol": "nsdeploy-agent-mcp/v1",
    "network": "riverside_clinic",
    "front_man": "riverside_clinic_assistant",
    "available": false,
    "reason": "This is a static bundle; a public MCP facade requires an application host."
  },
  "theme": {
    "primary": "#0f5c53"
  },
  "linking": {
    "protocol": "nsdeploy-link/v1",
    "exports": [
      {
        "network": "riverside_clinic",
        "front_man": "riverside_clinic_assistant",
        "aliases": [
          "riverside_clinic",
          "riverside_clinic_assistant"
        ],
        "url": "riverside_clinic"
      }
    ],
    "imports": [],
    "link_updates": {
      "mode": "browser-local"
    }
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": true,
    "direct_mcp_requires_cors": true,
    "public_mcp_facade": false
  },
  "actions": {
    "version": 1,
    "module": "./site-actions.js",
    "bridge": "./bridge/action-bridge.html",
    "agentTools": [
      "get_clinic_state",
      "select_slot",
      "book_slot"
    ]
  }
}
